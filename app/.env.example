# Copy this file to ".env" and fill in what you need. Restart the server after changing it.
# Without these settings, OTP codes are printed in the server console (fine for testing, not for real users).

# ---- Email OTP (any SMTP provider: Gmail app password, Amazon SES, Brevo, Zoho, ...) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MockDesk <no-reply@yourdomain.com>"

# ---- Mobile OTP: choose ONE provider ----
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx            # or use TWILIO_MESSAGING_SERVICE_SID=

# SMS_PROVIDER=msg91                  # India: needs a DLT-approved OTP template
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# ---- General ----
# PORT=3000
# NODE_ENV=production                 # use behind HTTPS; also makes missing OTP delivery an error instead of a console print

# ---- Reminders, push and referrals (all optional) ----
# MOCKDESK_PUBLIC_URL=https://mock.example.com   # your site address; used in emails and invite links
# MOCKDESK_TZ=Asia/Kolkata                       # clock for quiet hours and "tomorrow at 10:00"
# MOCKDESK_EMAIL_DAILY_CAP=2000                  # most reminder emails per day
# MOCKDESK_PRACTICE_PER_DAY=5                    # practice sets per student per day
# MOCKDESK_SCHEDULER=off                         # turn off the 10-minute reminder sender
# MOCKDESK_VAPID_PUBLIC=                         # push keys (generated automatically if empty)
# MOCKDESK_VAPID_PRIVATE=
